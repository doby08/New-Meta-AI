# ---- Server ----
PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string
# Initial administrator password (username: Dan). Change after first login.
ADMIN_PASSWORD=10231998

# ---- OpenAI (get a key at https://platform.openai.com/api-keys) ----
# When set, the system uses real AI for questions, analysis & reports.
# When empty, Ollama fallback then smart built-in generator is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- STEP 4: Local Ollama fallback (offline-capable, no key needed) ----
# Install: https://ollama.com — then: ollama pull llama3 (or mistral)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3
